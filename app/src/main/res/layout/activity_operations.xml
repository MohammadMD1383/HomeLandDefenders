<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	tools:context="ir.androidDev.homeLandDefenders.OperationActivity">
	
	<androidx.appcompat.widget.Toolbar
		android:id="@+id/tlb_operationsActivity_toolbar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_alignParentTop="true"
		android:background="@color/colorPrimary">
		
		<RelativeLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginEnd="16dp">
			
			<ImageView
				android:id="@+id/iv_operationsActivity_back"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_alignParentStart="true"
				android:layout_centerVertical="true"
				android:clickable="true"
				android:focusable="true"
				android:foreground="?attr/selectableItemBackground"
				android:padding="4dp"
				app:srcCompat="@drawable/ic_baseline_arrow_back_24" />
			
			<TextView
				android:id="@+id/tv_operationsActivity_titleTv"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_alignParentEnd="true"
				android:layout_centerVertical="true"
				android:layout_marginStart="8dp"
				android:layout_toEndOf="@id/iv_operationsActivity_back"
				android:ellipsize="marquee"
				android:marqueeRepeatLimit="marquee_forever"
				android:singleLine="true"
				android:text="@string/operations_string_title"
				android:textColor="@android:color/white"
				android:textSize="20sp" />
			
			<androidx.appcompat.widget.SearchView
				android:id="@+id/sv_operationsActivity_searchView"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_centerVertical="true"
				android:layoutDirection="ltr"
				app:closeIcon="@drawable/ic_baseline_close_24"
				app:searchIcon="@drawable/ic_baseline_search_24" />
		</RelativeLayout>
	</androidx.appcompat.widget.Toolbar>
	
	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/rv_operationsActivity_recyclerView"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:layout_above="@id/tv_operationsActivity_bottomTv"
		android:layout_below="@id/tlb_operationsActivity_toolbar"
		android:clipToPadding="false"
		android:paddingStart="8dp"
		android:paddingEnd="8dp"
		android:paddingBottom="8dp" />
	
	<TextView
		android:id="@+id/tv_operationsActivity_bottomTv"
		android:layout_width="match_parent"
		android:layout_height="?attr/actionBarSize"
		android:layout_alignParentBottom="true"
		android:background="@color/iran_red"
		android:gravity="center"
		android:text="@string/operations_string_bottom"
		android:textColor="@android:color/white"
		android:textSize="20sp"
		android:textStyle="bold" />
	
	<com.google.android.material.floatingactionbutton.FloatingActionButton
		android:id="@+id/fab_operationsActivity_loadState"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_above="@id/tv_operationsActivity_bottomTv"
		android:layout_alignParentEnd="true"
		android:layout_marginEnd="8dp"
		android:layout_marginBottom="8dp"
		android:clickable="true"
		android:focusable="true"
		app:srcCompat="@drawable/ic_baseline_remove_red_eye_24" />
</RelativeLayout>