<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/crd_recyclerItemOperationCard_cardView"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginTop="8dp"
	android:clickable="true"
	android:focusable="true"
	android:foreground="?attr/selectableItemBackground"
	app:cardCornerRadius="4dp"
	app:cardElevation="4dp">
	
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="375dp"
		android:orientation="vertical">
		
		<FrameLayout
			android:layout_width="match_parent"
			android:layout_height="300dp"
			android:background="@color/material_gray_300">
			
			<ImageView
				android:id="@+id/iv_recyclerItemOperationCard_photo"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:layout_gravity="center"
				android:adjustViewBounds="true"
				app:srcCompat="@drawable/ic_baseline_photo_24" />
		</FrameLayout>
		
		<TextView
			android:id="@+id/tv_recyclerItemOperationCard_name"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:ellipsize="end"
			android:gravity="center"
			android:maxLines="2"
			android:padding="8dp"
			android:textSize="16sp"
			tools:text="نقشه عملیت جنگ کربلای 5 به فرماندهی سرلشگر عباس بابایی" />
	</LinearLayout>
</androidx.cardview.widget.CardView>