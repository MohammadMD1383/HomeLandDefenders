<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginTop="16dp"
	android:orientation="vertical">
	
	<TextView
		android:id="@+id/tv_recyclerItemHelp_title"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@drawable/settings_section_header_bg"
		android:gravity="center"
		android:textStyle="bold"
		tools:text="عنوان" />
	
	<ImageView
		android:id="@+id/iv_recyclerItemHelp_image"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginVertical="8dp"
		android:adjustViewBounds="true"
		tools:src="@drawable/flower" />
	
	<TextView
		android:id="@+id/tv_recyclerItemHelp_text"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		tools:text="یک متن جهت دیدن چطوری" />
</LinearLayout>